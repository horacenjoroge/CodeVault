---
import SectionLabel from "./SectionLabel.astro";

const audienceBlocks = [
  {
    number: "01",
    title: "Founders with rough ideas",
    copy:
      "You have the product direction, market insight, or business problem — but need someone to turn it into screens, flows, data, integrations, and a build plan that can actually ship.",
    examples: ["MVPs", "SaaS prototypes", "AI tools", "Investor/demo builds"],
  },
  {
    number: "02",
    title: "Businesses with broken workflows",
    copy:
      "Your team is wasting time in spreadsheets, manual follow-ups, disconnected tools, or repetitive admin. You need software that reduces friction and gives the business a cleaner operating system.",
    examples: ["Dashboards", "Automations", "Internal tools", "API integrations"],
  },
  {
    number: "03",
    title: "Products that need rescue",
    copy:
      "You already have a website, app, or codebase, but it is slow, unfinished, buggy, unclear, or hard to extend. You need structure, cleanup, fixes, and a practical path forward.",
    examples: ["Refactors", "Bug fixing", "Performance", "Deployment repair"],
  },
];
---

<section class="section" id="qualification">
  <div class="shell qualification-shell" data-reveal>
    <div class="section-split built-for-split">
      <div>
        <SectionLabel label="Built For" />
        <h2>
          For teams that need <span class="qualification-accent">software momentum</span>
          without building a <span class="qualification-accent">full engineering department</span>.
        </h2>
        <p class="section-lead narrow-copy">
          CodeVault is for founders, operators, and small teams who need practical software
          shipped clearly: websites and portals that build trust, MVPs that validate ideas,
          dashboards that organize work, automations that remove manual tasks, and
          products that are easier to maintain after launch.
        </p>
      </div>

      <div class="illustration-wrap built-for-illustration-wrap">
        <img
          src="/illustrations/3.svg"
          alt="Planning and building a software product"
          class="section-illustration built-for-illustration"
        />
      </div>
    </div>

    <div class="qualification-grid">
      {audienceBlocks.map((block) => (
        <article class="qualification-card">
          <p class="qualification-number">{block.number}</p>
          <h3>{block.title}</h3>
          <p>{block.copy}</p>
          <div class="qualification-examples" aria-label={`${block.title} examples`}>
            {block.examples.map((example) => (
              <span class="qualification-chip">{example}</span>
            ))}
          </div>
        </article>
      ))}
    </div>

    <div class="qualification-band">
      <p class="qualification-band-label">Not a good fit when</p>
      <p>
        This is not the right engagement if the goal is only to find the cheapest
        possible code, start without clear priorities, skip review cycles, or expect a
        complete product overnight. CodeVault works best when there is a real business
        problem, a decision-maker involved, and a willingness to define the scope before
        building.
      </p>
    </div>
  </div>
</section>
