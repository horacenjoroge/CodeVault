---
import SectionLabel from "./SectionLabel.astro";
---

<section class="section section-dark" id="final-cta">
  <div class="shell cta-grid" data-reveal>
    <div>
      <SectionLabel label="Next Step" />
      <h2>Tell CodeVault what you need built. We’ll help you find the clearest path to ship it.</h2>
    </div>

    <div class="cta-copy">
      <p class="section-lead">
        30 minutes. Bring the idea, broken workflow, unfinished product, deadline, and
        budget range. We’ll help you understand what to build first and how to move forward.
      </p>
      <div class="hero-actions">
        <a class="button button-accent" href="mailto:hello@codevault.co.ke?subject=Project%20Inquiry">
          Book 30 minutes →
        </a>
        <p>Or write: <a class="text-link text-link-light" href="mailto:hello@codevault.co.ke">hello@codevault.co.ke</a></p>
      </div>
    </div>
  </div>
</section>
