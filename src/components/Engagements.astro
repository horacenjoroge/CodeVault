---
import SectionLabel from "./SectionLabel.astro";

const offers = [
  {
    number: "01",
    title: "Websites & Portals",
    bestFor: "Businesses that need a serious website, client portal, internal portal, or web presence that explains the offer, supports operations, and creates trust.",
    includes: "Information architecture, UI direction, responsive build, forms, content structure, integrations, analytics setup, and deployment support.",
    timeline: "Scoped after discovery.",
    cta: "Start a website or portal inquiry →",
    service: "Websites & Portals",
  },
  {
    number: "02",
    title: "MVP Build",
    bestFor: "Founders who need a working SaaS, app, internal tool, or AI-powered product.",
    includes: "Scope, UI, frontend, backend, database, integrations, testing, launch support.",
    timeline: "Scoped after discovery.",
    cta: "Plan an MVP build →",
    service: "MVP Build",
  },
  {
    number: "03",
    title: "Product Rescue",
    bestFor: "Existing projects that are buggy, slow, unfinished, or hard to maintain.",
    includes: "Audit, bug fixing, refactor plan, performance improvements, UI polish, deployment fixes.",
    timeline: "Depends on project condition.",
    cta: "Fix an existing product →",
    service: "Product Rescue / Bug Fixing",
  },
  {
    number: "04",
    title: "Monthly Build Partner",
    bestFor: "Ongoing product work without hiring a full-time developer.",
    includes: "Planned milestones, weekly updates, feature work, fixes, reviews, and support.",
    timeline: "Monthly engagement.",
    cta: "Discuss ongoing support →",
    service: "Monthly Build Partner",
  },
];
---

<section class="section section-soft" id="engagements">
  <div class="shell engagements-shell" data-reveal>
    <SectionLabel label="Engagements" />
    <h2>Choose the <span class="engagements-accent">build shape</span> that fits your stage.</h2>

    <div class="engagement-grid">
      {offers.map((offer) => (
        <article class="engagement-card">
          <p class="row-number">{offer.number}</p>
          <h3>{offer.title}</h3>
          <p><strong class="engagement-label">Best for:</strong> {offer.bestFor}</p>
          <p><strong class="engagement-label">Includes:</strong> {offer.includes}</p>
          <p class="engagement-timeline"><strong class="engagement-label">Timeline:</strong> {offer.timeline}</p>
          <a
            class="text-link engagement-link"
            href={offer.service === "Websites & Portals"
              ? "/start-project?service=websites-portals"
              : offer.service === "MVP Build"
                ? "/start-project?service=mvp-build"
                : offer.service === "Product Rescue / Bug Fixing"
                  ? "/start-project?service=product-rescue"
                  : "/start-project?service=monthly-build-partner"}
          >
            {offer.cta}
          </a>
        </article>
      ))}
    </div>

    <div class="value-callout">
      <h3>You will spend <span class="value-callout-accent">less time</span> managing the build.</h3>
      <p>
        A poor build costs more than the developer fee. It costs time, trust, missed
        launches, and rework. The goal is to make the scope clear, ship useful software,
        and keep you informed at every step.
      </p>
      <a class="text-link value-callout-link" href="/start-project">See what your project needs →</a>
    </div>
  </div>
</section>
