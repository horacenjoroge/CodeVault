---
import SectionLabel from "./SectionLabel.astro";

const projects = [
  {
    title: "Cvelo — AI job application assistant",
    type: "SaaS + Chrome extension",
    stack: "React, FastAPI, PostgreSQL, Redis, Chrome Extension",
    summary: "Helps users autofill job applications, tailor resumes, generate cover letters, and manage application workflows.",
  },
  {
    title: "Alumni Connect — mobile alumni networking app",
    type: "Mobile social app",
    stack: "React Native, Node.js, MongoDB",
    summary: "Alumni networking app with groups, events, posts, profiles, and messaging.",
  },
  {
    title: "Fitness Training App — mobile activity tracker",
    type: "Mobile tracking app",
    stack: "React Native, Express, MongoDB",
    summary: "Tracks running, cycling, swimming, and gym sessions with performance metrics.",
  },
  {
    title: "Business Websites & Portals — client-facing and internal web systems",
    type: "Website / Portal",
    stack: "Astro, React, Next.js, Tailwind, Node.js",
    summary: "Professional websites and portals built around clear positioning, useful workflows, forms, integrations, and maintainable structure.",
  },
];
---

<section class="section" id="work">
  <div class="shell" data-reveal>
    <SectionLabel label="Selected Work" />
    <h2>Projects CodeVault can help you build.</h2>

    <div class="work-list">
      {projects.map((project) => (
        <article class="work-row">
          <div>
            <h3>{project.title}</h3>
          </div>
          <p class="work-meta">
            Type: {project.type}
            <br />
            Stack: {project.stack}
          </p>
          <p>{project.summary}</p>
          <a class="text-link" href="/start-project?service=websites-portals">Request similar work →</a>
        </article>
      ))}
    </div>
  </div>
</section>
