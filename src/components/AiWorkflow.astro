---
import SectionLabel from "./SectionLabel.astro";

const aiHelpsWith = ["Planning", "Debugging", "Refactoring", "Documentation", "Review"];
const teamOwns = [
  "Architecture",
  "Product decisions",
  "Security",
  "User experience",
  "Final quality",
];
---

<section class="section" id="ai-workflow">
  <div class="shell ai-workflow-grid" data-reveal>
    <div class="ai-workflow-copy">
      <SectionLabel label="AI In The Workflow" />
      <h2>
        AI speeds up the build.
        <span class="ai-workflow-accent">Judgment still owns the result.</span>
      </h2>
      <p class="section-lead">
        CodeVault’s team uses AI where it helps: planning, debugging, refactoring,
        documentation, repetitive implementation, and review. But architecture, product
        decisions, security, user experience, and final quality control stay with the team.
      </p>
      <p class="strong-line">
        The goal is not AI decoration. The goal is useful software shipped with less waste
        — reviewed by people who understand the product, the code, and the business
        outcome.
      </p>
      <a class="button button-dark ai-workflow-cta" href="#final-cta">Book a 30-minute build call →</a>
    </div>

    <aside class="ai-workflow-box" aria-label="AI-assisted workflow">
      <div class="illustration-wrap illustration-frame ai-illustration-wrap">
        <img
          src="/illustrations/4.svg"
          alt="CodeVault team using AI tools while owning product decisions"
          class="section-illustration ai-illustration"
        />
      </div>

      <div class="ai-workflow-panel">
        <p class="ai-workflow-panel-label">AI Helps With</p>
        <ul class="ai-workflow-list">
          {aiHelpsWith.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>

      <div class="ai-workflow-panel">
        <p class="ai-workflow-panel-label">Team Owns</p>
        <ul class="ai-workflow-list">
          {teamOwns.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
</section>
