---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const title = "Privacy Policy — CodeVault";
const description =
  "Read CodeVault’s Privacy Policy to understand how we collect, use, protect, and handle personal information when you visit our website or contact us about a project.";
const updated = "June 04, 2026";

const sections = [
  {
    id: "who-we-are",
    number: "01",
    title: "Who We Are",
    body: [
      "CodeVault is a software development studio based in Kenya and working with clients remotely.",
      "Contact: hello@codevault.co.ke",
    ],
  },
  {
    id: "scope",
    number: "02",
    title: "Scope of This Policy",
    body: [
      "This policy applies to the CodeVault website, contact forms, project inquiry forms, email communications, and related client-intake interactions.",
      "If a client signs a separate commercial services agreement, that agreement may contain additional terms for project delivery, confidentiality, data handling, and intellectual property.",
    ],
  },
  {
    id: "information",
    number: "03",
    title: "Information We Collect",
    list: [
      "Name",
      "Email address",
      "Phone number if provided",
      "Company or project name",
      "Project description",
      "Budget range",
      "Timeline",
      "Files or links the user voluntarily shares",
      "Communication records",
      "Website usage data such as pages visited, device/browser data, approximate location, referral source, and timestamps",
    ],
  },
  {
    id: "use",
    number: "04",
    title: "How We Use Information",
    list: [
      "Respond to inquiries",
      "Evaluate project fit",
      "Prepare proposals or scopes",
      "Communicate about services",
      "Deliver agreed software services",
      "Improve the website and services",
      "Maintain security",
      "Comply with legal obligations",
    ],
  },
  {
    id: "legal-basis",
    number: "05",
    title: "Legal Basis for Processing",
    body: [
      "Where applicable, CodeVault relies on lawful bases recognized under the Kenya Data Protection Act, 2019, including consent, performance of a contract or steps before entering into a contract, legitimate interests, and legal obligation.",
    ],
  },
  {
    id: "ai-assisted",
    number: "06",
    title: "AI-Assisted Workflows",
    body: [
      "CodeVault may use AI tools to support planning, drafting, debugging, documentation, research, and workflow improvement.",
      "CodeVault does not intentionally submit sensitive client data to AI tools unless necessary and agreed.",
      "Clients should avoid sending highly sensitive information through public contact forms. If project data requires special handling, this should be agreed in writing.",
    ],
  },
  {
    id: "sharing",
    number: "07",
    title: "Sharing of Information",
    body: [
      "CodeVault may share limited data with email and hosting providers, analytics tools, form handling tools, project management tools, payment or invoicing providers if used, contractors or collaborators where needed, and legal authorities where required by law.",
    ],
  },
  {
    id: "transfers",
    number: "08",
    title: "International Transfers",
    body: [
      "Some service providers may process data outside Kenya. CodeVault uses reasonable safeguards where applicable when selecting and working with those providers.",
    ],
  },
  {
    id: "retention",
    number: "09",
    title: "Data Retention",
    body: [
      "CodeVault keeps personal data only as long as needed for inquiries, service delivery, legal obligations, accounting, dispute resolution, or legitimate business records.",
    ],
  },
  {
    id: "security",
    number: "10",
    title: "Data Security",
    body: [
      "CodeVault uses reasonable technical and organizational safeguards such as access controls, secure storage, HTTPS, limited access, confidentiality practices, and secure development practices.",
      "No internet-based system is completely secure.",
    ],
  },
  {
    id: "cookies",
    number: "11",
    title: "Cookies and Analytics",
    body: [
      "The site may use essential cookies and analytics technologies. Users can manage cookies through their browser settings.",
    ],
  },
  {
    id: "rights",
    number: "12",
    title: "Your Rights",
    list: [
      "Access data",
      "Correct data",
      "Request deletion",
      "Object to processing",
      "Restrict processing",
      "Withdraw consent",
      "Request portability where applicable",
      "Lodge a complaint with the Office of the Data Protection Commissioner of Kenya",
    ],
  },
  {
    id: "children",
    number: "13",
    title: "Children’s Privacy",
    body: [
      "The website and services are not intended for children under 18.",
    ],
  },
  {
    id: "changes",
    number: "14",
    title: "Changes to This Policy",
    body: [
      "CodeVault may update this policy and will update the “Last updated” date when material changes are made.",
    ],
  },
  {
    id: "contact",
    number: "15",
    title: "Contact",
    body: [
      "For privacy questions: hello@codevault.co.ke",
    ],
  },
];
---

<BaseLayout title={title} description={description}>
  <Header />
  <main>
    <section class="legal-hero">
      <div class="legal-shell">
        <span class="section-label">Legal</span>
        <h1>Privacy Policy</h1>
        <p class="legal-updated">Last updated: {updated}</p>
        <p class="legal-intro">
          This Privacy Policy explains how CodeVault collects, uses, stores, and protects
          personal information when you visit our website, contact us, submit a project
          inquiry, or engage with our services.
        </p>
        <p class="legal-notice">
          This page is provided for transparency and should be reviewed by legal counsel
          before production use.
        </p>
      </div>
    </section>

    <section class="legal-content">
      <div class="legal-shell">
        <div class="legal-toc">
          <p class="legal-toc-title">Contents</p>
          <ol class="legal-toc-list">
            {sections.map((section) => (
              <li><a href={`#${section.id}`}>{section.title}</a></li>
            ))}
          </ol>
        </div>

        {sections.map((section) => (
          <section class="legal-section" id={section.id}>
            <span class="legal-section-number">{section.number}</span>
            <h2>{section.title}</h2>
            {section.body?.map((paragraph) => <p>{paragraph}</p>)}
            {section.list && (
              <ul>
                {section.list.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
