---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Problem from "../components/Problem.astro";
import Qualification from "../components/Qualification.astro";
import Process from "../components/Process.astro";
import BuildLedger from "../components/BuildLedger.astro";
import AiWorkflow from "../components/AiWorkflow.astro";
import InsideVault from "../components/InsideVault.astro";
import NoBlackBox from "../components/NoBlackBox.astro";
import Engagements from "../components/Engagements.astro";
import FAQ from "../components/FAQ.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "CodeVault — Software systems for founders and growing teams";
const description =
  "CodeVault helps founders and small teams build custom software, web applications, mobile applications, websites and portals, API integrations, databases, automations, and production-ready systems with clear scope and clean handoff.";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main>
    <Hero />
    <Problem />
    <Qualification />
    <Process />
    <BuildLedger />
    <AiWorkflow />
    <InsideVault />
    <NoBlackBox />
    <Engagements />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
</BaseLayout>
